rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Toda cuenta existente es administradora (lectura pública, escritura solo con sesión).
    // La seguridad depende de que las cuentas solo se creen desde la consola.
    function isAdmin() { return signedIn(); }

    match /users/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.values is map;
      allow delete: if isAdmin();
    }

    match /fieldDefinitions/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 80
        && request.resource.data.type in
           ['text','textarea','number','date','boolean','select','url'];
      allow delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Todo lo demás, denegado (incluida cualquier colección de roles)
    match /{document=**} { allow read, write: if false; }
  }
}
