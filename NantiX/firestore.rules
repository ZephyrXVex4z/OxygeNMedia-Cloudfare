rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Toda cuenta existente es administradora (las cuentas solo se crean desde la consola;
    // desactiva el registro público en Authentication → Settings → User actions).
    function isAdmin() { return signedIn(); }

    function validPost(d, s) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.category is string && d.category.size() <= 40
        && d.status == s
        && d.meta is map
        && d.downloads is list && d.downloads.size() <= 20
        && d.scopes is list && d.scopes.size() <= 200
        && d.tags is list && d.tags.size() <= 30;
    }

    // Publicadas: lectura pública. Escritura solo con sesión.
    match /posts/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost(request.resource.data, 'published');
      allow delete: if isAdmin();
    }
    // Borradores: solo con sesión.
    match /drafts/{id} {
      allow read, delete: if signedIn();
      allow create, update: if isAdmin() && validPost(request.resource.data, 'draft');
    }

    // Reportes: cualquiera puede crear (validado); solo administradores leen y borran.
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['postId', 'postTitle', 'reason', 'message', 'createdAt'])
        && request.resource.data.reason in ['Enlace roto', 'Contenido publicado sin autorización', 'Otro']
        && request.resource.data.postId is string && request.resource.data.postId.size() <= 60
        && request.resource.data.postTitle is string && request.resource.data.postTitle.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, delete: if signedIn();
      allow update: if false;
    }

    // Colecciones de la versión anterior (fichas dinámicas): sin cambios.
    match /users/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.values is map;
      allow delete: if isAdmin();
    }
    match /fieldDefinitions/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.label is string
        && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 80
        && request.resource.data.type in ['text','textarea','number','date','boolean','select','url'];
      allow delete: if isAdmin();
    }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
