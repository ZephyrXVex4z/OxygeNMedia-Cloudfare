<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>hecho en 6 o 7 minutos</title>

  <style>
    /* =========================
       BASE
    ========================= */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --rosa: #f7a8c4;
      --rosa-claro: #ffe4ee;
      --rosa-suave: #fff1f6;
      --lavanda: #d9c7f5;
      --lavanda-claro: #f2ecff;
      --crema: #fffaf7;
      --texto: #49384a;
      --texto-suave: #725d72;
      --borde: #f1c8da;
      --blanco: #ffffff;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;

      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      color: var(--texto);

      background:
        radial-gradient(
          circle at 10% 10%,
          #ffd8e7 0,
          transparent 28%
        ),
        radial-gradient(
          circle at 90% 90%,
          #e8ddff 0,
          transparent 30%
        ),
        var(--crema);
    }


    /* =========================
       FONDO
    ========================= */

    .fondo {
      position: fixed;
      inset: 0;

      pointer-events: none;
      overflow: hidden;

      z-index: 0;
    }

    .corazon {
      position: absolute;
      bottom: -40px;

      color: #f3a9c3;

      opacity: 0;

      animation: subir linear forwards;
    }

    @keyframes subir {
      0% {
        transform: translateY(0) rotate(0deg);
        opacity: 0;
      }

      15% {
        opacity: .55;
      }

      85% {
        opacity: .35;
      }

      100% {
        transform:
          translateY(-110vh)
          rotate(180deg);

        opacity: 0;
      }
    }


    /* =========================
       CONTENEDOR
    ========================= */

    .contenedor {
      position: relative;
      z-index: 1;

      width: 100%;
      min-height: 100vh;

      display: flex;
      justify-content: center;

      padding: 35px 16px;
    }


    /* =========================
       TARJETA PRINCIPAL
    ========================= */

    .tarjeta {
      width: min(720px, 100%);

      padding: 42px 30px;

      text-align: center;

      background:
        rgba(255, 255, 255, .88);

      border:
        1px solid var(--borde);

      border-radius: 30px;

      box-shadow:
        0 15px 45px rgba(116, 70, 100, .12);

      animation:
        aparecer .9s ease both;
    }

    @keyframes aparecer {
      from {
        opacity: 0;
        transform: translateY(25px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }


    /* =========================
       EMOJI
    ========================= */

    .emoji {
      display: inline-block;

      font-size: 58px;

      margin-bottom: 18px;

      animation:
        latido 1.8s ease-in-out infinite;
    }

    @keyframes latido {
      0%, 100% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.1);
      }
    }


    /* =========================
       TÍTULO
    ========================= */

    h1 {
      font-size:
        clamp(2rem, 7vw, 3.6rem);

      line-height: 1.12;

      margin-bottom: 22px;

      color: #b85d83;
    }


    /* =========================
       SEPARADOR
    ========================= */

    .separador {
      width: 75px;
      height: 3px;

      margin: 26px auto;

      border-radius: 10px;

      background:
        linear-gradient(
          90deg,
          #f4a6c2,
          #c9b2ed
        );
    }


    /* =========================
       INTRODUCCIÓN
    ========================= */

    .introduccion {
      font-size: 1.05rem;

      line-height: 1.8;

      color: var(--texto-suave);

      margin-bottom: 28px;
    }

    .introduccion p {
      margin-bottom: 17px;
    }

    .introduccion p:last-child {
      margin-bottom: 0;
    }


    /* =========================
       IMÁGENES
    ========================= */

    .imagen {
      display: block;

      width: 100%;
      max-width: 100%;

      aspect-ratio: 1 / 1;

      object-fit: cover;

      border-radius: 22px;

      border:
        4px solid var(--blanco);

      outline:
        1px solid var(--borde);

      box-shadow:
        0 8px 25px rgba(100, 60, 90, .12);

      transition:
        transform .25s ease;
    }

    .imagen:hover {
      transform:
        scale(1.015)
        rotate(.5deg);
    }


    /* =========================
       POSTDATAS
    ========================= */

    .postdatas {
      display: flex;

      flex-direction: column;

      gap: 12px;

      margin: 28px 0;
    }

    .pd {
      text-align: left;

      padding: 17px 19px;

      border-radius: 18px;

      line-height: 1.6;

      color: var(--texto);

      background:
        linear-gradient(
          135deg,
          #fff0f6,
          #f8f1ff
        );

      border:
        1px solid #efcddd;

      box-shadow:
        0 5px 15px rgba(100, 60, 90, .05);

      transition:
        transform .2s ease;
    }

    .pd:hover {
      transform: translateX(4px);
    }

    .pd strong {
      color: #bd6288;
    }


    /* =========================
       BOTÓN
    ========================= */

    button {
      border: none;

      margin-top: 18px;

      padding: 14px 23px;

      border-radius: 999px;

      background:
        linear-gradient(
          135deg,
          #f3a3c0,
          #c7afea
        );

      color: white;

      font-size: 1rem;

      font-weight: 700;

      cursor: pointer;

      box-shadow:
        0 8px 22px rgba(180, 105, 145, .2);

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    button:hover {
      transform: translateY(-2px);

      box-shadow:
        0 11px 27px rgba(180, 105, 145, .28);
    }

    button:active {
      transform: scale(.97);
    }


    /* =========================
       MENSAJE OCULTO
    ========================= */

    .mensaje {
      max-height: 0;

      overflow: hidden;

      opacity: 0;

      transition:
        max-height .7s ease,
        opacity .5s ease,
        margin .7s ease;
    }

    .mensaje.mostrar {
      max-height: 350px;

      opacity: 1;

      margin-top: 25px;
    }

    .mensaje-contenido {
      padding: 24px 20px;

      border-radius: 22px;

      background:
        linear-gradient(
          135deg,
          #fff0f6,
          #f3edff
        );

      border:
        1px solid #e4cbe4;
    }

    .mensaje p {
      line-height: 1.8;

      color: var(--texto-suave);

      margin-bottom: 12px;
    }

    .firma {
      margin-top: 18px;

      color: #9d6685;

      font-weight: 600;
    }


    /* =========================
       FOOTER
    ========================= */

    .final {
      margin-top: 30px;

      color: #ad7896;

      font-size: .9rem;
    }


    /* =========================
       MÓVIL
    ========================= */

    @media (max-width: 600px) {

      .contenedor {
        padding:
          18px 12px;
      }

      .tarjeta {
        padding:
          32px 19px;

        border-radius: 24px;
      }

      .emoji {
        font-size: 50px;
      }

      h1 {
        font-size: 2.15rem;
      }

      .introduccion {
        font-size: 1rem;
      }

      button {
        max-width: 100%;

        line-height: 1.4;
      }
    }


    /* =========================
       MENOS ANIMACIONES
       PARA DISPOSITIVOS QUE
       LO PREFIERAN
    ========================= */

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }

  </style>
</head>


<body>

  <!-- Fondo animado -->
  <div
    class="fondo"
    id="fondo"
    aria-hidden="true">
  </div>


  <main class="contenedor">

    <section class="tarjeta">


      <!-- =========================
           ENCABEZADO
      ========================= -->

      <div class="emoji">
        ❤️
      </div>


      <h1>
        Estemmm... si no eres Liliana no entiendo que haces en esta web xd
      </h1>


      <div class="separador"></div>


      <!-- =========================
           TEXTO
      ========================= -->

      <div class="introduccion">

        <p>
          No soy alguien muy romantico pero si alguien que
          quizas pueda sacarte una sonrisa.
        </p>

        <p>
          Y la verdad no espero que esto te haga reir,
          pero tampoco esperes tanto de un programador
          con sueño a las 2am con hambre y gripe jaja :v
        </p>

      </div>


      <!-- =========================
           PRIMERA IMAGEN
      ========================= -->

      <img
        class="imagen"
        src="https://entrenoelalma.org/digitalers01/gatimili/imagenes/sjkajs%203.jpeg"
        alt="Una imagen especial"
        loading="lazy"
        decoding="async"
      >


      <div class="separador"></div>


      <!-- =========================
           POSTDATAS
      ========================= -->

      <div class="postdatas">

        <div class="pd">
          <strong>Pd:</strong>
          Te gustan los 67? a mi si creo muejejeje 🗿
        </div>

        <div class="pd">
          <strong>Pd 2:</strong>
          Creo que me estoy enamorando de ti ❤️
        </div>

        <div class="pd">
          <strong>Pd 3:</strong>
          aiuda 💀
        </div>

      </div>


      <!-- =========================
           SEGUNDA IMAGEN
      ========================= -->

      <img
        class="imagen"
        src="https://wallpapers.com/images/hd/hello-kitty-valentine-heart-8813skae7k6ps1cd.webp"
        alt="Hello Kitty con temática de San Valentín"
        loading="lazy"
        decoding="async"
      >


      <div class="separador"></div>


      <!-- =========================
           BOTÓN
      ========================= -->

      <button
        type="button"
        id="botonMensaje"
        aria-expanded="false"
        aria-controls="mensaje">

        Si me tocas tendrás 67 años de buena suerte... 🍀

      </button>


      <!-- =========================
           MENSAJE OCULTO
      ========================= -->

      <div
        class="mensaje"
        id="mensaje">

        <div class="mensaje-contenido">

          <p>
            Ya no se que poner aqui jeje,
            pero mira el lado positiva,
            tendras 67 años de buena suerte :>
          </p>

          <p>
            tqm &lt;3 ❤️
          </p>

          <div class="firma">
            — El programador con sueño 🗿
          </div>

        </div>

      </div>


      <!-- =========================
           FINAL
      ========================= -->

      <div class="final">
        ★ Gracias por llegar hasta aquí, te amo ♡
      </div>

    </section>

  </main>


  <script>

    /* =========================
       CORAZONES
       Ligero para móvil
    ========================= */

    const fondo =
      document.getElementById("fondo");

    let corazonesActivos = 0;

    const MAX_CORAZONES = 14;


    function crearCorazon() {

      if (corazonesActivos >= MAX_CORAZONES) {
        return;
      }

      corazonesActivos++;

      const corazon =
        document.createElement("span");

      corazon.className =
        "corazon";

      corazon.textContent =
        Math.random() > .5
          ? "♡"
          : "♥";

      corazon.style.left =
        Math.random() * 100 + "%";

      corazon.style.fontSize =
        (12 + Math.random() * 14) + "px";

      const duracion =
        7 + Math.random() * 5;

      corazon.style.animationDuration =
        duracion + "s";

      fondo.appendChild(corazon);


      setTimeout(() => {

        corazon.remove();

        corazonesActivos--;

      }, duracion * 1000);

    }


    setInterval(
      crearCorazon,
      900
    );


    /* =========================
       MENSAJE
    ========================= */

    const boton =
      document.getElementById(
        "botonMensaje"
      );

    const mensaje =
      document.getElementById(
        "mensaje"
      );


    boton.addEventListener(
      "click",
      () => {

        const abierto =
          mensaje.classList.toggle(
            "mostrar"
          );

        boton.setAttribute(
          "aria-expanded",
          abierto
        );

      }
    );

  </script>

</body>
</html>
